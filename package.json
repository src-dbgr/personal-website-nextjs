{
  "name": "personal-website-nextjs",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "analyze": "ANALYZE=true next build",
    "develop": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "export": "next export",
    "update-check": "npx npm-check-updates",
    "update": "npx npm-check-updates -u && npm install",
    "clean": "rm -rf .next",
    "clean-cache": "npx cache clean --force",
    "clean-install": "rm -rf .next && rm -rf node_modules && rm -f package-lock.json && npm cache clean --force && npm install && echo 'Clean install completed. Remember to restart your dev server!'"
  },
  "dependencies": {
    "@apollo/client": "^4.2.10",
    "@emotion/is-prop-valid": "^1.4.0",
    "@juggle/resize-observer": "^3.4.0",
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "@react-three/postprocessing": "^3.0.5",
    "@types/three": "^0.185.4",
    "animejs": "^3.2.2",
    "aos": "^2.3.4",
    "graphql": "^17.0.2",
    "js-cookie": "^3.0.8",
    "lucide-react": "^1.31.0",
    "next": "^16.3.0",
    "prop-types": "^15.8.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-icons": "^5.7.0",
    "react-markdown": "^10.1.0",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^16.3.0",
    "eslint": "^10.8.1",
    "eslint-config-next": "^16.3.0",
    "npm-check-updates": "^23.0.2",
    "serve": "^14.2.6"
  }
}
