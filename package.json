{
  "name": "personal-website-nextjs",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "analyze": "ANALYZE=true next build",
    "develop": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "export": "next export",
    "update-check": "npx npm-check-updates",
    "update": "npx npm-check-updates -u && npm install",
    "clean": "rm -rf .next",
    "clean-cache": "npx cache clean --force",
    "clean-install": "rm -rf .next && rm -rf node_modules && rm -f package-lock.json && npm cache clean --force && npm install && echo 'Clean install completed. Remember to restart your dev server!'"
  },
  "dependencies": {
    "@apollo/client": "^4.0.9",
    "@emotion/is-prop-valid": "^1.3.1",
    "@juggle/resize-observer": "^3.4.0",
    "@loadable/component": "^5.16.4",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.4.0",
    "@types/three": "^0.181.0",
    "animejs": "^3.2.2",
    "aos": "^2.3.4",
    "framer-motion": "^11.12.0",
    "graphql": "^16.9.0",
    "js-cookie": "^3.0.5",
    "next": "^16.0.3",
    "patch-package": "^8.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-icons": "^5.3.0",
    "react-markdown": "^10.1.0",
    "rxjs": "^7.8.2",
    "three": "^0.181.2"
  },
  "overrides": {
    "patch-package": {
      "minimist": "~1.2.6"
    }
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^16.0.3",
    "eslint": "^9.39.1",
    "eslint-config-next": "^16.0.3",
    "npm-check-updates": "^19.1.2",
    "serve": "^14.2.4"
  }
}
